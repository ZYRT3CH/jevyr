{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jevyr.local/schema/benchmark-corpus-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requiredInvariants", "cases"],
  "properties": {
    "protocol": { "const": "jevyr.benchmark-corpus/1" },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "requiredInvariants": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "impulse", "expect"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "category": { "type": "string", "minLength": 1 },
          "impulse": { "type": "string", "minLength": 1 },
          "pair": { "type": "string", "minLength": 1, "maxLength": 128 },
          "seed": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "mode": { "enum": ["auto", "audit", "design"] },
          "privacy": { "enum": ["local_only", "provider_scoped", "full_case"] },
          "constraints": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 100000 } },
          "requestedAssays": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 100000 } },
          "subjects": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "kind", "locator"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 128 },
                "kind": { "enum": ["git", "directory", "file", "url", "text", "artifact"] },
                "locator": { "type": "string", "minLength": 1, "maxLength": 1000000 },
                "revision": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["creation", "judgment"],
            "properties": {
              "integrity": { "enum": ["VALID", "INVALID"] },
              "creation": { "enum": ["CONCEIVED", "NO_SURVIVOR", "FAILED", "PRESENT"] },
              "embodiment": { "enum": ["BUILT", "NOT_BUILT", "FAILED"] },
              "judgment": { "enum": ["ACCEPT", "REJECT", "UNPROVEN", "NOT_APPLICABLE", "PRESENT"] }
            }
          }
        }
      }
    }
  }
}
