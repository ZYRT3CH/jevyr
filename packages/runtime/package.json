{
  "name": "@jevyr/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-controllers.mjs && node scripts/build-pure-producer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "@jevyr/core": "workspace:*",
    "@jevyr/growth": "workspace:*",
    "@jevyr/memory": "workspace:*",
    "@jevyr/protocol": "workspace:*",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261"
  }
}
