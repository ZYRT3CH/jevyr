{
  "name": "@jevyr/remotion-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render:preview": "remotion render src/index.tsx JevyrExplainer out/jevyr-preview.mp4 --frames=0-899 --crf=16",
    "render": "remotion render src/index.tsx JevyrExplainer out/jevyr-explainer.mp4 --crf=16",
    "render:short": "remotion render src/index.tsx JevyrLaunchShort out/jevyr-launch-short.mp4 --crf=16",
    "render:what-if": "remotion render src/index.tsx JevyrWhatIfShort out/jevyr-what-if-short.mp4 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "remotion": "4.0.526",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
