# Canonical local Jevyr daemon address.
JEVYR_HOST=127.0.0.1
JEVYR_PORT=4317
JEVYR_PROJECT_ROOT=C:\absolute\path\to\project
# Relative state paths resolve beneath JEVYR_PROJECT_ROOT.
JEVYR_DATA_DIR=.jevyr

# Forge mode, image, resources, subject capture, search physics, Reflex, memory,
# and growth invariants come from <project>/.jevyr/policy.json. Environment
# variables cannot weaken that sealed project policy.
# JEVYR_FORGE_PLAN_FILE=C:\absolute\path\to\forge-plan.json

# Optional external MCP witnesses. Servers and exact calls are fixed before
# Cast; credential values may cross only through names listed in this file.
# Their output is quarantined observation data and can never prove a claim.
# JEVYR_MCP_WITNESSES_FILE=C:\absolute\path\to\mcp-witnesses.json

# Optional durable Genome registry. Relative paths resolve beneath the explicit
# project root; the default registry is <data-dir>/genome-registry. The trust
# file contains Ed25519 PUBLIC keys only. If an active pointer exists, its full
# signed promotion chain must verify against one of these exact keys or startup
# fails closed. The pointer is read once per daemon start, never per Case.
# JEVYR_GENOME_REGISTRY_DIR=.jevyr/genome-registry
# JEVYR_GENOME_GOVERNANCE_TRUST_FILE=.jevyr/genome-governance-trust.json

# Provider minds are opt-in. Rule Mind always remains available without credentials.
# JEVYR_CODEX_ENABLED=1
# JEVYR_CODEX_APP_SERVER_ENABLED=1
# JEVYR_CODEX_MODEL=gpt-5.6-codex
# JEVYR_CLAUDE_ENABLED=1
# JEVYR_CLAUDE_MODEL=sonnet
# JEVYR_OLLAMA_MODEL=qwen3-coder:30b
# JEVYR_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/
# JEVYR_LMSTUDIO_MODEL=local-model
# JEVYR_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1/

# Optional audience-bound credential broker for an OpenAI-compatible endpoint.
# The named variable contains the value; only its reference is configuration.
# JEVYR_OPENAI_COMPATIBLE_MODEL=operator-selected-model
# JEVYR_OPENAI_COMPATIBLE_BASE_URL=https://operator-selected-provider.example/v1/
# JEVYR_OPENAI_COMPATIBLE_CREDENTIAL_REF=MY_PROVIDER_TOKEN
# JEVYR_OPENAI_COMPATIBLE_ALLOW_REMOTE=1

# Remote HTTP bind remains an explicit deployment decision. It does not weaken
# the project's Forge or evidence policy.
# JEVYR_ALLOW_REMOTE_BIND=1

# Optional startup-bound A2A 1.0 peers. Credentials are broker reference names
# in the config, never literal secrets or Case fields.
# JEVYR_PEERS_FILE=.jevyr/peers.json

# Generic one-shot executable: exact projected prompt on stdin, one structured
# contribution JSON document on stdout. Arbitrary host executable, not a sandbox;
# this bridge declares unrestricted network and is excluded from local_only.
# JEVYR_STDIN_COMMAND=C:\Tools\my-model-wrapper.exe
# JEVYR_STDIN_ARGS_JSON=["--format","jevyr-json"]
# JEVYR_STDIN_PROBE_ARGS_JSON=["--version"]
# JEVYR_STDIN_TIMEOUT_MS=180000
